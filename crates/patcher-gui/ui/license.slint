import { Theme, Patcher, Strings } from "api.slint";
import { Heading, Scroll, Checkbox } from "widgets.slint";

export component LicenseScreen inherits Rectangle {
    VerticalLayout {
        padding-left: 44px;
        padding-right: 44px;
        padding-top: 14px;
        spacing: 14px;
        Heading { text: Strings.license-heading; }
        Scroll {
            vertical-stretch: 1;
            content-height: body.preferred-height + 28px;
            body := Text {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                text: Patcher.license-text;
                font-family: Theme.font-mono;
                font-size: 12px;
                color: Theme.dim;
                wrap: word-wrap;
            }
        }
        if Patcher.require-accept: Checkbox {
            text: Strings.license-accept;
            checked: Patcher.license-accepted;
            toggled(v) => { Patcher.accept-license(v); }
        }
    }
}
