import { Theme, Patcher } from "api.slint";
import { IconButton } from "widgets.slint";

export component TitleBar inherits Rectangle {
    height: 40px;
    TouchArea {
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                Patcher.drag-window();
            }
        }
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 6px;
        padding-top: 5px;
        spacing: 2px;
        Text {
            text: Patcher.mod-name + (Patcher.mod-version != "" ? "  " + Patcher.mod-version : "");
            font-family: Theme.font-body;
            font-weight: 600;
            font-size: 12px;
            color: Theme.faint;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
        IconButton {
            icon: "minimize";
            clicked => { Patcher.minimize(); }
        }
        IconButton {
            icon: "close";
            enabled: Patcher.can-close;
            clicked => { Patcher.close(); }
        }
    }
}
